{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "julia",
            "name": "Launch RocketPlumber REPL (2 default + 1 interactive)",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/repl_launch.jl",
            "env": {
                "JULIA_PROJECT": "${workspaceFolder}/dev",
                "JULIA_NUM_THREADS": "2,1"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
