{
    "customLocalFormatters.formatters": [
        {
            "command": "julia --project=@runic --startup-file=no -e \"using Runic; exit(Runic.main(ARGS))\"",
            "languages": ["julia"]
        }
    ],

    // Ensure the integrated terminal (and VS Code-launched tasks) default to 2 worker threads,
    // 1 interactive main thread, and 1 mark + 1 concurrent sweep GC thread.
    "terminal.integrated.env.windows": {
        "JULIA_NUM_THREADS": "2,1",
        "JULIA_NUM_GC_THREADS": "1,1"
    },
    "terminal.integrated.env.linux": {
        "JULIA_NUM_THREADS": "2,1",
        "JULIA_NUM_GC_THREADS": "1,1"
    },
    "terminal.integrated.env.osx": {
        "JULIA_NUM_THREADS": "2,1",
        "JULIA_NUM_GC_THREADS": "1,1"
    },
    "chat.tools.terminal.autoApprove": {
        "/^julia --threads=2,1 --gcthreads=1,1 --project=\\. src/julia_main\\.jl$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "Pkg.resolve()": true,
        "Pkg.test(\\\"HexFlowProcGen\\\")": true,
        "\\\"HexFlowProcGen\\\"": true,
        "/^julia tools/encounter_balance\\.jl$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^julia --project=\\. -e \"using Pkg; Pkg\\.test\\(\\\\\"HexFlowProcGen\\\\\"\\)\"$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^julia --project=\\. -e 'using Pkg; Pkg\\.test\\(\"HexFlowProcGen\"\\)'$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "Pkg.test(string(:HexFlowProcGen))": true,
        "string(:HexFlowProcGen)": true,
        ":HexFlowProcGen": true
    }
}